# =============================================================================
# Required: at least one LLM endpoint (OpenAI-compatible)
# =============================================================================
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot-v1-32k

# Output language for the digest: zh or en. Default: zh
DIGEST_LANG=zh

# =============================================================================
# Sources (optional but recommended — without these only RSS works)
# =============================================================================
# Domestic Chinese AI/tech sources defined in config/feeds_zh.yaml.
# On by default. Set to 0 to skip them entirely.
ENABLE_ZH_SOURCES=1

# X / Twitter — cookies from a logged-in browser session.
# DevTools -> Application -> Cookies -> https://x.com, copy auth_token and ct0.
# Both are required; with either empty the X step is skipped (not an error).
X_AUTH_TOKEN=
X_CT0=

# Proxy for X only. Local use in mainland China: http://127.0.0.1:7897
# Leave empty when running on GitHub Actions (runners reach x.com directly).
PROXY_URL=

# =============================================================================
# Publishers (any combination — leave empty to publish to local file only)
# =============================================================================
# Comma-separated list. If empty, every configured publisher runs.
# Example: PUBLISHERS=markdown,telegram
PUBLISHERS=

# WeChat Official Account
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Telegram channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# Optional
# =============================================================================
# Enable the China-mainland sensitive-word filter (off by default)
ENABLE_CONTENT_FILTER=

# Skip podcast audio generation
DISABLE_AUDIO=

# Server酱 WeChat push notification
SERVERCHAN_KEY=
